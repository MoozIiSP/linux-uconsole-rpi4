From: MoozIiSP <mooziisp@example.com>
Subject: [PATCH] drivers/power: axp20x - Add IPSOUT management, energy props, and calibration support

- Add IPSOUT current management in AC power IRQ handler
- Add ENERGY_FULL, ENERGY_NOW, ENERGY_FULL_DESIGN properties
- Add AXP228 calibration support (CALIBRATE property)

---
 drivers/power/supply/axp20x_ac_power.c |  3 ++
 drivers/power/supply/axp20x_battery.c  | 71 +++++++++++++++++++++++++++++++++-
 2 files changed, 73 insertions(+), 1 deletion(-)

--- a/drivers/power/supply/axp20x_ac_power.c	2026-04-27 14:25:56
+++ b/drivers/power/supply/axp20x_ac_power.c	2026-04-27 14:26:55
@@ -52,6 +52,9 @@
 {
 	struct axp20x_ac_power *power = devid;
 
+	/* do not limit IPSOUT current */
+	regmap_update_bits(power->regmap, AXP20X_VBUS_IPSOUT_MGMT, 0x03, 0x03);
+
 	power_supply_changed(power->supply);
 
 	return IRQ_HANDLED;

--- a/drivers/power/supply/axp20x_battery.c	2026-04-27 14:25:59
+++ b/drivers/power/supply/axp20x_battery.c	2026-04-27 14:29:38
@@ -41,6 +41,10 @@
 #define AXP20X_PWR_OP_BATT_PRESENT	BIT(5)
 #define AXP20X_PWR_OP_BATT_ACTIVATED	BIT(3)
 #define AXP717_PWR_OP_BATT_PRESENT	BIT(3)
+
+#define AXP228_FULL_CAPACITY_CALIBRATE_EN	BIT(2)
+#define AXP228_CAPACITY_CALIBRATE		BIT(1)
+#define AXP228_CALIBRATE_MASK			GENMASK(2, 1)
 
 #define AXP717_BATT_PMU_FAULT_MASK	GENMASK(2, 0)
 #define AXP717_BATT_UVLO_2_5V		BIT(2)
@@ -119,6 +123,7 @@
 	/* Maximum constant charge current */
 	unsigned int max_ccc;
 	const struct axp_data	*data;
+	unsigned int energy_full_design;
 	bool ts_disable;
 };
 
@@ -396,6 +401,24 @@
 		val->intval = reg & AXP209_FG_PERCENT;
 		break;
 
+	case POWER_SUPPLY_PROP_ENERGY_FULL:
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_PWR_OP_MODE,
+				  &reg);
+		if (ret)
+			return ret;
+		if (!(reg & AXP20X_PWR_OP_BATT_PRESENT)) {
+			val->intval = 0;
+			return 0;
+		}
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_FG_RES, &reg);
+		val->intval = (reg & AXP209_FG_PERCENT) * 1000; /* uAh */
+		return 0;
+
+	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
+		val->intval = axp20x_batt->energy_full_design;
+		return 0;
+
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX:
 		return axp20x_batt->data->get_max_voltage(axp20x_batt,
 							  &val->intval);
@@ -551,6 +574,24 @@
 		val->intval = reg & AXP209_FG_PERCENT;
 		return 0;
 
+	case POWER_SUPPLY_PROP_ENERGY_FULL:
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_PWR_OP_MODE,
+				  &reg);
+		if (ret)
+			return ret;
+		if (!(reg & AXP20X_PWR_OP_BATT_PRESENT)) {
+			val->intval = 0;
+			return 0;
+		}
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_FG_RES, &reg);
+		val->intval = (reg & AXP209_FG_PERCENT) * 1000; /* uAh */
+		return 0;
+
+	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
+		val->intval = axp20x_batt->energy_full_design;
+		return 0;
+
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX:
 		return axp20x_batt->data->get_max_voltage(axp20x_batt,
 							  &val->intval);
@@ -770,6 +811,7 @@
 				   const union power_supply_propval *val)
 {
 	struct axp20x_batt_ps *axp20x_batt = power_supply_get_drvdata(psy);
+	unsigned int val1;
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_VOLTAGE_MIN:
@@ -784,6 +826,15 @@
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
 		return axp20x_set_max_constant_charge_current(axp20x_batt,
 							      val->intval);
+
+	case POWER_SUPPLY_PROP_CALIBRATE:
+		if (val->intval)
+			val1 = AXP228_FULL_CAPACITY_CALIBRATE_EN | AXP228_CAPACITY_CALIBRATE;
+		else
+			val1 = 0;
+		return regmap_update_bits(axp20x_batt->regmap, AXP20X_CC_CTRL,
+					  AXP228_CALIBRATE_MASK, val1);
+
 	case POWER_SUPPLY_PROP_STATUS:
 		switch (val->intval) {
 		case POWER_SUPPLY_STATUS_CHARGING:
@@ -806,6 +857,7 @@
 				   const union power_supply_propval *val)
 {
 	struct axp20x_batt_ps *axp20x_batt = power_supply_get_drvdata(psy);
+	unsigned int val1;
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_VOLTAGE_MIN:
@@ -817,6 +869,15 @@
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
 		return axp717_set_constant_charge_current(axp20x_batt,
 							  val->intval);
+
+	case POWER_SUPPLY_PROP_CALIBRATE:
+		if (val->intval)
+			val1 = AXP228_FULL_CAPACITY_CALIBRATE_EN | AXP228_CAPACITY_CALIBRATE;
+		else
+			val1 = 0;
+		return regmap_update_bits(axp20x_batt->regmap, AXP20X_CC_CTRL,
+					  AXP228_CALIBRATE_MASK, val1);
+
 	case POWER_SUPPLY_PROP_STATUS:
 		switch (val->intval) {
 		case POWER_SUPPLY_STATUS_CHARGING:
@@ -872,7 +933,8 @@
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MIN ||
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MAX ||
 	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT ||
-	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX;
+	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX ||
+	       psp == POWER_SUPPLY_PROP_CALIBRATE;
 }
 
 static int axp717_battery_prop_writeable(struct power_supply *psy,
@@ -881,7 +943,8 @@
 	return psp == POWER_SUPPLY_PROP_STATUS ||
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MIN ||
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MAX ||
-	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX;
+	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX ||
+	       psp == POWER_SUPPLY_PROP_CALIBRATE;
 }
 
 static const struct power_supply_desc axp209_batt_ps_desc = {
